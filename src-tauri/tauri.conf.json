{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aleya",
  "version": "1.0.0",
  "identifier": "app.solstice.wallpaper",
  "build": {
    "beforeDevCommand": "node scripts/tauri-dev-frontend.mjs",
    "devUrl": "http://127.0.0.1:8080",
    "beforeBuildCommand": "node scripts/tauri-build-frontend.mjs",
    "frontendDist": "../dist-tauri/client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aleya",
        "width": 1280,
        "height": 800,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "visible": false,
        "decorations": true,
        "backgroundColor": "#0c0c12"
      }
    ],
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "tooltip": "Aleya"
    },
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://127.0.0.1:8080 http://localhost:8080; img-src 'self' asset: http://asset.localhost https://asset.localhost blob: data: https:; media-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src ipc: http://ipc.localhost http://asset.localhost https://asset.localhost http://127.0.0.1:8080 http://localhost:8080 ws://localhost:8080 ws://127.0.0.1:8080",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Aleya",
        "compression": "lzma"
      }
    }
  }
}
